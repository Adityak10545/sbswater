# ------------------------------------------------------------------
#  SBS Water - Apache / LiteSpeed config for Hostinger (public_html)
#  Canonical host: https://www.sbswater.in (see scripts/seo/seo.config.mjs)
# ------------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# /services and /blogs are both a page (service.html, blogs.html) and a
# folder of sub-pages, so stop Apache adding a trailing slash to them.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# ---------- Redirects ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # sbswater.in → https://www.sbswater.in, and http → https, each one 301.
    # Scoped to the real domain so Hostinger's temporary preview URL still works.
    RewriteCond %{HTTP_HOST} ^sbswater\.in$ [NC]
    RewriteRule ^ https://www.sbswater.in%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Keep build/dev files off the public site if they are ever uploaded
    RewriteRule (^|/)(node_modules|scripts|docs|\.git|\.vscode)(/|$) - [F,L,NC]
    RewriteRule (^|/)(package(-lock)?\.json|\.gitignore)$ - [F,L,NC]
    RewriteRule \.(scss|md|mjs|map)$ - [F,L,NC]

    # ---------- Clean URLs (no .html) ----------
    # Public paths must match `path` in scripts/seo/seo.config.mjs.
    # THE_REQUEST is the browser's original request line, so these 301s
    # only fire for typed/old links, never for the internal rewrites below.

    # Old .html URLs → clean URLs (keeps old links and search results working)
    RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
    RewriteRule ^index\.html$ / [L,R=301]
    RewriteCond %{THE_REQUEST} \s/+about\.html[?\s] [NC]
    RewriteRule ^about\.html$ /about-us [L,R=301]
    RewriteCond %{THE_REQUEST} \s/+service\.html[?\s] [NC]
    RewriteRule ^service\.html$ /services [L,R=301]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s] [NC]
    RewriteRule ^ /%1 [L,R=301,NE]

    # File names that differ from their public path
    RewriteRule ^about$ /about-us [L,R=301]
    RewriteRule ^service$ /services [L,R=301]
    RewriteRule ^index$ / [L,R=301]

    # Trailing slash → none (/about-us/ → /about-us, /services/ → /services)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Clean URLs → the HTML files that serve them
    RewriteRule ^about-us$ about.html [L]
    RewriteRule ^services$ service.html [L]
    RewriteRule ^blogs$ blogs.html [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/manifest+json .webmanifest
    AddType video/mp4 .mp4
    AddCharset utf-8 .html .css .js .xml .txt .webmanifest
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/ttf application/vnd.ms-fontobject
</IfModule>

# ---------- Browser caching ----------
# CSS/JS are versioned by content hash (?v=…, see scripts/build-assets.mjs),
# so they can be cached for a year. Images keep their names when replaced,
# so they get a month. HTML is always revalidated so edits show at once.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/plain "access plus 1 hour"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Basic hardening
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
